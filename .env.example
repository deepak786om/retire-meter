# ─── Supabase ────────────────────────────────────────────────────────────────
# Create the project in the ap-south-1 (Mumbai) region. DPDP does not mandate
# blanket localisation, but sectoral regulators impose their own expectations on
# financial data, and migrating later is expensive.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server only. Never prefix with NEXT_PUBLIC_ — it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Zerodha Kite Connect (optional) ─────────────────────────────────────────
# Kite Connect Personal is free and covers holdings, positions and funds, which is
# all this app needs. The paid plan is for market data.
# KITE_API_SECRET must never reach the browser: the SHA-256 checksum is computed
# inside /api/kite/callback, server-side.
KITE_API_KEY=
KITE_API_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
